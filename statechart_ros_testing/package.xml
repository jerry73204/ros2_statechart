<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>statechart_ros_testing</name>
  <version>0.1.0</version>
  <description>Test kit for statecharts: fake invoke kinds, scenario runner, property tests, launch_testing helpers.</description>
  <maintainer email="jerry73204@gmail.com">jerry73204</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/jerry73204/ros2_statechart</url>
  <url type="bugtracker">https://github.com/jerry73204/ros2_statechart/issues</url>

  <exec_depend>statechart_ros</exec_depend>
  <exec_depend>statechart_ros_msgs</exec_depend>
  <exec_depend>python3-hypothesis</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>example_interfaces</test_depend>
  <test_depend>statechart_ros_nav2</test_depend>
  <test_depend>launch</test_depend>
  <test_depend>launch_ros</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>turtlesim</test_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>nav2_msgs</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <test_depend>std_msgs</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
