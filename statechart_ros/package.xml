<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>statechart_ros</name>
  <version>0.1.3</version>
  <description>The node that hosts a statechart: loader for the ros: extension of SCXML, one event queue, invokes, outputs, introspection, lifecycle.</description>
  <maintainer email="jerry73204@gmail.com">jerry73204</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/jerry73204/ros2_statechart</url>
  <url type="bugtracker">https://github.com/jerry73204/ros2_statechart/issues</url>

  <exec_depend>python_statemachine_vendor</exec_depend>
  <exec_depend>python3-lxml</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>statechart_ros_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- The turtlesim example also needs turtlesim (in ros-jazzy-desktop), not
       declared here so that the node does not pull in Qt. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>example_interfaces</test_depend>
  <test_depend>std_msgs</test_depend>
  <test_depend>std_srvs</test_depend>
  <test_depend>nav2_msgs</test_depend>
  <test_depend>launch</test_depend>
  <test_depend>launch_ros</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>geometry_msgs</test_depend>
  <test_depend>turtlesim</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
